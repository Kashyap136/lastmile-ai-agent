# ---- Required for Agentverse / ASI:One registration ----
# Create an API key at https://agentverse.ai/profile/api-keys
AGENTVERSE_KEY=
# Any stable secret phrase. It deterministically derives the agent address.
AGENT_SEED_PHRASE=lastmile-rescue-coordinator-demo-seed

# ---- Optional: specialist agent addresses (Layer 3 multi-agent mode) ----
SAFETY_AGENT_ADDRESS=
MATCHER_AGENT_ADDRESS=
PLANNER_AGENT_ADDRESS=
# single = all logic in the coordinator process (default, reliable demo)
# multi  = delegate to the specialist agents above (with retries + explicit failures)
AGENT_TOPOLOGY=single

# ---- Optional service credentials ----
# Real routing API (OSRM-compatible), e.g. https://router.project-osrm.org
# When unset, the planner uses clearly-labelled calculated estimates.
ROUTING_API_URL=
# Optional webhook that receives confirmed pickup plans. When set, the
# coordinator only marks a donation "dispatched_to_recipient" on HTTP 2xx.
RECIPIENT_NOTIFY_WEBHOOK=

# ---- Local server ----
# Must be provided through your environment when seeding; example:
#   macOS/Linux:  export AGENT_SEED_PHRASE="..."
#   Windows PS:   $env:AGENT_SEED_PHRASE="..."
PORT=8000
LOG_LEVEL=INFO
